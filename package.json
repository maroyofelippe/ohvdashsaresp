{
  "name": "ohvdashsaresp",
  "version": "1.0.0",
  "description": "OHVDashSaresp — lançamento e análise de avaliações SARESP da E. E. Prof. Orlando Horácio Vita",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "node scripts/copy-vendor.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "node scripts/reset-db.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests public/js",
    "format": "prettier --write .",
    "modelos": "node scripts/gerar-modelos.js",
    "db:setup": "node scripts/setup-db.js",
    "db:check": "node scripts/check-db.js",
    "setup": "node scripts/setup-db.js --completo",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:test": "docker compose run --rm -e SKIP_MIGRATIONS=true app npm test",
    "docker:seed": "docker compose exec app npx sequelize-cli db:seed:all",
    "docker:sh": "docker compose exec app sh",
    "docker:reset": "docker compose down -v && docker compose up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.2.2",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/helpers/globalSetup.js",
    "setupFiles": [
      "./tests/helpers/env.js"
    ],
    "testTimeout": 30000,
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "coverageThreshold": {
      "./src/services/correcao.service.js": {
        "lines": 100,
        "functions": 100,
        "statements": 100
      }
    }
  }
}
