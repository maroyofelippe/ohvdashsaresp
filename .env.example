# ===== Aplicação =====
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ=America/Sao_Paulo
LOG_LEVEL=info

# ===== Banco de dados (usado FORA do Docker: PostgreSQL 14+ local ou hospedagem; alvo: 18) =====
# No Docker estes valores são substituídos automaticamente pelo banco do contêiner (veja DOCKER_* abaixo).
# Use 127.0.0.1 (e não "localhost") para evitar que o Node tente IPv6 (::1) no Windows.
# DB_USER/DB_PASSWORD são as credenciais DA APLICAÇÃO: o "npm run db:setup" cria esse usuário
# usando a conta de administrador do PostgreSQL (postgres), que não fica gravada em lugar nenhum.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=OHVDashSaresp
DB_NAME_TEST=OHVDashSaresp_test
DB_USER=ohv
DB_PASSWORD=troque_esta_senha
# SSL (obrigatório no Aiven e na maioria dos PostgreSQL gerenciados). DB_SSL_CA = caminho do ca.pem
# (relativo à raiz do projeto); sem ele, usa as CAs do sistema.
# DB_SSL=true
# DB_SSL_CA=src/config/seg/ca.pem
# Opcional (só para npm run db:setup sem perguntas): conta de administrador do PostgreSQL
# DB_ADMIN_USER=postgres
# DB_ADMIN_DATABASE=postgres   (no Aiven: defaultdb)
# DB_ADMIN_PASSWORD=

# ===== Docker (opcional — padrões já funcionam) =====
# DOCKER_DB_NAME=OHVDashSaresp
# DOCKER_DB_USER=ohv
# DOCKER_DB_PASSWORD=ohv_dev_pass
# DOCKER_DB_PORT=5433
# DOCKER_APP_PORT=3000
# DOCKER_ADMINER_PORT=8080
# DOCKER_APP_URL=http://localhost:3000

# ===== Segredos (>= 32 caracteres; gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") =====
JWT_SECRET=
REFRESH_SECRET=
CSRF_SECRET=

# ===== Admin nativo (criado pelo seeder; troca de senha obrigatória no 1º login) =====
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@professor.educacao.sp.gov.br
ADMIN_PASSWORD=TroqueJa2026

# ===== Cadastro =====
ALLOWED_EMAIL_DOMAIN=professor.educacao.sp.gov.br
REQUIRE_ADMIN_APPROVAL=true

# ===== Correção e insights =====
ANULADA_CONTA_ACERTO=true
INSIGHT_HABILIDADE_POSITIVA=70
INSIGHT_HABILIDADE_ATENCAO=50
INSIGHT_ALUNO_CRITICO=40

# ===== E-mail (em desenvolvimento, sem SMTP_HOST, os e-mails são exibidos no console) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OHVDashSaresp <nao-responda@escola.sp.gov.br>"
