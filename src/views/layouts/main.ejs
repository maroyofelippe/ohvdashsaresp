<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="ohv-inatividade-min" content="<%= inatividadeMin %>">
  <title><%= titulo %> · OHVDashSaresp</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/tema-init.js"></script>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/print.css" media="print">
</head>
<body>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  <%- include('../partials/header') %>
  <div class="shell">
    <%- include('../partials/sidebar') %>
    <main id="conteudo" tabindex="-1">
      <div class="cabecalho-oficial"><img src="<%= escola.logotipo || '/img/cabecalho.png' %>" alt="Cabeçalho institucional — <%= escola.escola %>"></div>
      <%- body %>
    </main>
  </div>
  <%- include('../partials/toast') %>
  <%- include('../partials/drawer') %>
  <script type="module" src="/js/app.js"></script>
  <%- script %>
</body>
</html>
